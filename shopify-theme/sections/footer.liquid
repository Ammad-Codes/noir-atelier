<footer class="site-footer lx-foot">
  <div class="lx-foot__strip" aria-hidden="true"><figure class="lx-foot__strip-item lx-zoom"><img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=600&q=70&auto=format&fit=crop" alt="" width="600" height="750" loading="lazy"></figure><figure class="lx-foot__strip-item lx-zoom"><img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=600&q=70&auto=format&fit=crop" alt="" width="600" height="750" loading="lazy"></figure><figure class="lx-foot__strip-item lx-zoom"><img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?w=600&q=70&auto=format&fit=crop" alt="" width="600" height="750" loading="lazy"></figure><figure class="lx-foot__strip-item lx-zoom"><img src="https://images.unsplash.com/photo-1507680434567-5739c80be1ac?w=600&q=70&auto=format&fit=crop" alt="" width="600" height="750" loading="lazy"></figure><figure class="lx-foot__strip-item lx-zoom"><img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=600&q=70&auto=format&fit=crop" alt="" width="600" height="750" loading="lazy"></figure></div>
  <div class="lx-foot__bg" aria-hidden="true"><img src="{{ 'hero-store.webp' | asset_url }}" alt="" width="2048" height="1152" loading="lazy"></div>
  <div class="container">
    <div class="lx-foot__top lx-up">
      <div class="lx-foot__intro"><svg class="lx-mono" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120"><title>NOIR ATELIER</title><g fill="none" stroke="currentColor"><circle cx="60" cy="60" r="56" stroke-width="1.2"/><circle cx="60" cy="60" r="50" stroke-width=".6" opacity=".6"/></g><g fill="currentColor" font-family="'Playfair Display','Didot','Bodoni 72',Georgia,serif"><text x="60" y="73" text-anchor="middle" font-size="44" letter-spacing="-2">N<tspan font-style="italic" dx="-6">A</tspan></text><text x="60" y="95" text-anchor="middle" font-size="6.5" letter-spacing="3.2" font-family="Helvetica,Arial,sans-serif">EST · MMXIV</text></g><path d="M38 28h44" stroke="currentColor" stroke-width=".8"/></svg>
<div><p class="eyebrow">{{ section.settings.nl_eyebrow | escape }}</p><h3 class="lx-foot__title">{{ section.settings.nl_heading }}</h3></div></div>
      {%- form 'customer', class: 'lx-foot__form', id: 'FooterNewsletter' -%}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="ft-email">Email</label><input id="ft-email" type="email" name="contact[email]" placeholder="{{ section.settings.nl_placeholder | escape }}" required><button type="submit">{% if form.posted_successfully? %}Thank you{% else %}Subscribe <span aria-hidden="true">→</span>{% endif %}</button>{%- endform -%}
    </div>
    <div class="lx-foot__cols" data-lx-stagger>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}><h4>{{ block.settings.heading | escape }}</h4><ul>{%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}</ul></div>
      {%- endfor -%}
      <div><h4>{{ section.settings.visit_heading | escape }}</h4><address>{{ section.settings.address }}</address><p>{{ section.settings.hours | escape }}</p><p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a><br>{{ section.settings.phone | escape }}</p></div>
    </div>
    <div class="lx-foot__social"><span>Follow @noir.atelier</span><div class="socials">
        <a href="{{ settings.social_instagram | default: '#' }}" aria-label="Instagram">{% render 'icon-instagram' %}</a>
        <a href="{{ settings.social_pinterest | default: '#' }}" aria-label="Pinterest">{% render 'icon-pinterest' %}</a>
        <a href="{{ settings.social_tiktok | default: '#' }}" aria-label="TikTok">{% render 'icon-tiktok' %}</a>
      </div></div>
    <p class="lx-foot__mark" data-lx-lines aria-hidden="true"><span class="lx-line"><span>{{ settings.brand_name | default: shop.name | upcase | escape }}</span></span></p>
    <div class="lx-foot__bottom"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ 'footer.rights' | t }} · {{ powered_by_link }}</span><div class="lx-pay"><img src="{{ 'pay-visa.svg' | asset_url }}" alt="Visa" width="46" height="29" loading="lazy"><img src="{{ 'pay-mastercard.svg' | asset_url }}" alt="Mastercard" width="46" height="29" loading="lazy"><img src="{{ 'pay-amex.svg' | asset_url }}" alt="American Express" width="46" height="29" loading="lazy"><img src="{{ 'pay-paypal.svg' | asset_url }}" alt="PayPal" width="46" height="29" loading="lazy"><img src="{{ 'pay-applepay.svg' | asset_url }}" alt="Apple Pay" width="46" height="29" loading="lazy"></div></div>
  </div>
</footer>
{% schema %}
{
 "name": "Footer",
 "max_blocks": 3,
 "settings": [
  {
   "type": "text",
   "id": "nl_eyebrow",
   "label": "Newsletter eyebrow",
   "default": "The Atelier Letter"
  },
  {
   "type": "text",
   "id": "nl_heading",
   "label": "Newsletter heading",
   "default": "Letters from the atelier, <em>once a month.</em>"
  },
  {
   "type": "text",
   "id": "nl_placeholder",
   "label": "Email placeholder",
   "default": "Your email address"
  },
  {
   "type": "text",
   "id": "visit_heading",
   "label": "Visit heading",
   "default": "Visit"
  },
  {
   "type": "textarea",
   "id": "address",
   "label": "Address",
   "default": "12 Example Avenue<br>Milan 20100, Italy"
  },
  {
   "type": "text",
   "id": "hours",
   "label": "Opening hours",
   "default": "Mon–Sat · 10:00–19:00"
  },
  {
   "type": "text",
   "id": "email",
   "label": "Email",
   "default": "hello@example.com"
  },
  {
   "type": "text",
   "id": "phone",
   "label": "Phone",
   "default": "+00 000 000 0000"
  }
 ],
 "blocks": [
  {
   "type": "links",
   "name": "Link list",
   "settings": [
    {
     "type": "text",
     "id": "heading",
     "label": "Heading"
    },
    {
     "type": "link_list",
     "id": "menu",
     "label": "Menu",
     "default": "footer"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "Footer",
   "blocks": [
    {
     "type": "links",
     "settings": {
      "heading": "Shop"
     }
    },
    {
     "type": "links",
     "settings": {
      "heading": "Atelier"
     }
    },
    {
     "type": "links",
     "settings": {
      "heading": "Help"
     }
    }
   ]
  }
 ]
}
{% endschema %}
