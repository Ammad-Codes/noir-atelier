<section class="section"><div class="container">
  <h1 class="section-title" style="margin-bottom:1.5rem">{{ 'general.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" class="search-panel__form" role="search" style="margin-bottom:2.5rem">
    <input type="hidden" name="type" value="product">
    <input class="search-panel__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
    <button class="btn btn--dark"><span class="btn__label">{{ 'general.search' | t }}</span></button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item, index: forloop.index0 %}{%- endif -%}
        {%- else -%}<p>{{ 'general.no_results' | t: terms: search.terms }}</p>{%- endfor -%}
      </div>
    {%- endpaginate -%}
  {%- endif -%}
</div></section>
{% schema %}
{"name":"Search","settings":[]}
{% endschema %}
