<section class="section categories">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow reveal-up">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="section-title"><span class="reveal-mask"><span>{{ section.settings.heading }}</span></span></h2>
      </div>
    </div>
    <div class="categories__grid">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a href="{{ col.url | default: '#' }}" class="category-card" data-tilt data-cursor="view" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: col.featured_image -%}
          {%- if img -%}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 100vw', widths: '600, 900, 1200' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
          <span class="category-card__glare"></span>
          <span class="category-card__body">
            <span>
              {%- if col -%}<span class="category-card__count">{{ 'collections.count' | t: count: col.products_count }}</span>{%- endif -%}
              <h3 class="category-card__title">{{ block.settings.title | default: col.title | escape }}</h3>
            </span>
            <span class="category-card__arrow">{% render 'icon-arrow' %}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Category cards","max_blocks":4,
"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Collections"},{"type":"text","id":"heading","label":"Heading","default":"Shop by <em>category</em>"}],
"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"title","label":"Title override"},{"type":"image_picker","id":"image","label":"Image override"}]}],
"presets":[{"name":"Category cards","blocks":[{"type":"category","settings":{"title":"Women"}},{"type":"category","settings":{"title":"Men"}},{"type":"category","settings":{"title":"Accessories"}}]}]}
{% endschema %}
