{%- assign col = section.settings.collection -%}
<section class="section featured-collection" id="shop">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow reveal-up">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="section-title"><span class="reveal-mask"><span>{{ section.settings.heading }}</span></span></h2>
      </div>
      {%- if col != blank -%}<a href="{{ col.url }}" class="btn btn--ghost reveal-up" data-magnetic><span class="btn__fill"></span><span class="btn__label">{{ 'general.view_all' | t }}</span></a>{%- endif -%}
    </div>
    <div class="product-grid" data-reveal>
      {%- if col != blank -%}
        {%- for product in col.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <article class="product-card reveal-up"><div class="product-card__media">{{ 'product-apparel-1' | placeholder_svg_tag }}</div><div class="product-card__info"><h3 class="product-card__title">{{ 'products.placeholder' | t }}</h3><span class="price">{{ 4800 | money }}</span></div></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured"},
{"type":"text","id":"heading","label":"Heading","default":"The new <em>edit</em>"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"range","id":"limit","label":"Products to show","min":4,"max":16,"step":4,"default":8}],
"presets":[{"name":"Featured collection"}]}
{% endschema %}
