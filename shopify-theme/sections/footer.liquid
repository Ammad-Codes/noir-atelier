<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading | default: block.settings.menu.title | escape }}</h4>
          <ul>{%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}</ul>
        </div>
      {%- endfor -%}
      <div>
        <h4>{{ 'footer.follow' | t }}</h4>
        <div class="socials">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon-instagram' %}</a>{%- endif -%}
          {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon-pinterest' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon-tiktok' %}</a>{%- endif -%}
        </div>
      </div>
    </div>
    <p class="footer-brand" aria-hidden="true">{{ settings.brand_name | default: shop.name | upcase | escape }}</p>
    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ 'footer.rights' | t }}</span>
      <span>{{ powered_by_link }}</span>
    </div>
  </div>
</footer>
{% schema %}
{"name":"Footer","max_blocks":4,
"blocks":[{"type":"links","name":"Link list","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]}],
"presets":[{"name":"Footer","blocks":[{"type":"links","settings":{"heading":"Shop"}},{"type":"links","settings":{"heading":"Help"}}]}]}
{% endschema %}
