<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <meta name="color-scheme" content="light">

  {%- comment -%} SEO {%- endcomment -%}
  <title>
    {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if page_image %}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200, height: 630, crop: 'center' }}">
  {% endif %}

  {%- comment -%} Fonts: Playfair Display (headings) and Manrope (body) {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@300;400;500;600;700&display=swap">

  {%- comment -%} Design tokens driven by theme settings {%- endcomment -%}
  <style>
    :root {
      --color-bg: {{ settings.color_background }};
      --color-text: {{ settings.color_text }};
      --color-accent: {{ settings.color_accent }};
      --color-surface: {{ settings.color_surface }};
      --color-muted: {{ settings.color_muted }};
      --color-sale: {{ settings.color_sale }};
      --radius-card: {{ settings.radius_card }}px;
      --radius-button: {{ settings.radius_button }}px;
      --radius-image: {{ settings.radius_image }}px;
      --section-space: {{ settings.section_spacing }}px;
      --container-max: {{ settings.container_max }}px;
      --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
      --font-heading: "Playfair Display", "Times New Roman", serif;
      --font-body: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>

<body class="template-{{ template.name | replace: '.', '-' }}{% if settings.enable_cursor %} has-cursor{% endif %}" data-currency="{{ cart.currency.iso_code }}" data-money-format="{{ shop.money_format | escape }}" data-free-threshold="{{ settings.free_shipping_threshold }}" data-animations="{% if settings.enable_flying_image %}fly{% endif %}">

  <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>

  {%- comment -%} Page loader: brand letters drop in, then a curtain splits open {%- endcomment -%}
  {% if settings.enable_loader %}
    <div class="loader" id="loader" aria-hidden="true">
      <div class="loader__letters">
        {% assign brand = settings.brand_name | upcase %}
        {% assign brand_letters = brand | split: '' %}
        {% for letter in brand_letters %}
          <span class="loader__letter" style="--i: {{ forloop.index0 }}">{% if letter == ' ' %}&nbsp;{% else %}{{ letter }}{% endif %}</span>
        {% endfor %}
      </div>
      <span class="loader__curtain loader__curtain--left"></span>
      <span class="loader__curtain loader__curtain--right"></span>
    </div>
  {% endif %}

  {%- comment -%} Custom cursor: dot + delayed ring {%- endcomment -%}
  {% if settings.enable_cursor %}
    <div class="cursor" aria-hidden="true">
      <span class="cursor__dot"></span>
      <span class="cursor__ring"><span class="cursor__label">{{ 'general.view' | t }}</span></span>
    </div>
  {% endif %}

  <div class="scroll-progress" aria-hidden="true"><span class="scroll-progress__bar"></span></div>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <filter id="liquid"><feTurbulence type="fractalNoise" baseFrequency="0.012 0.03" numOctaves="2" seed="3" result="n"><animate attributeName="baseFrequency" dur="6s" values="0.012 0.03;0.02 0.05;0.012 0.03" repeatCount="indefinite"/></feTurbulence><feDisplacementMap in="SourceGraphic" in2="n" scale="18"/></filter>
  </svg>

  {% sections 'header-group' %}

  <main id="main" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}

  <button class="to-top" data-to-top aria-label="{{ 'general.back_to_top' | t }}"><svg class="ring" viewBox="0 0 54 54"><circle cx="27" cy="27" r="24"/></svg>&uarr;</button>
  <div class="toast" role="status" aria-live="polite" data-toast></div>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
