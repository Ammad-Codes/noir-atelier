  <section class="lx-stats" id="stats">
    <div class="container">
      <div class="section-head" data-lx-lines><p class="eyebrow">The house in numbers</p><h2 class="section-title"><span class="lx-line"><span>{{ section.settings.heading }}</span></span></h2></div>
      <div class="lx-stats__grid" data-lx-stagger>
        <div><span class="lx-stat__num" data-count="12" data-suffix="">0</span><span class="lx-stat__label">Years of craft</span></div>
        <div><span class="lx-stat__num" data-count="48000" data-suffix="+">0</span><span class="lx-stat__label">Clients worldwide</span></div>
        <div><span class="lx-stat__num" data-count="36">0</span><span class="lx-stat__label">Artisan partners</span></div>
        <div><span class="lx-stat__num" data-count="100" data-suffix="%">0</span><span class="lx-stat__label">Traceable fabrics</span></div>
      </div>
    </div>
  </section>

{% schema %}
{
  "name": "Stats counters",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made slowly, <em>worn for years</em>"
    }
  ],
  "presets": [
    {
      "name": "Stats counters"
    }
  ]
}
{% endschema %}
